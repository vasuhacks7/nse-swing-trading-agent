# === AWS Configuration (recommended for deployment) ===
# AWS Region where Bedrock Claude models are enabled
AWS_REGION=ap-south-1

# AWS credentials (not needed if running on EC2 with IAM role attached)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# === Anthropic API Key (alternative to Bedrock, for local dev) ===
# If AWS_REGION is set, Bedrock is used. Otherwise falls back to direct API.
# ANTHROPIC_API_KEY=your_anthropic_api_key

# === Telegram Bot for push notifications ===
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Your channel/group chat ID (use @userinfobot or @getidsbot)
TELEGRAM_CHAT_ID=your_chat_id

# === Optional ===
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
